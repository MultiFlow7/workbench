{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    { "identifier": "fs:allow-read-file",  "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-read-dir",   "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-mkdir",      "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-exists",     "allow": [{ "path": "$HOME/**" }] }
  ]
}
