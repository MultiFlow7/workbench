{
  "name": "workbench",
  "private": true,
  "version": "0.16.2",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:package": "electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win:package": "electron-builder --win --publish never",
    "privacy:scan": "bash scripts/run-node.sh scripts/preflight-public-cleanliness.mjs --tracked",
    "privacy:scan:staged": "bash scripts/run-node.sh scripts/preflight-public-cleanliness.mjs --staged",
    "privacy:scan:build": "bash scripts/run-node.sh scripts/preflight-public-cleanliness.mjs --build",
    "privacy:scan:history": "bash scripts/run-node.sh scripts/preflight-public-cleanliness.mjs --history --all-refs",
    "design:stitch-context": "node scripts/design/export-stitch-context.mjs",
    "design:audit": "node scripts/design/audit-css-tokens.mjs",
    "design:screenshots": "node scripts/design/capture-ui-screenshots.mjs",
    "design:verify": "node scripts/design/verify-stitch-context.mjs",
    "design:refresh": "pnpm design:audit && pnpm design:stitch-context && pnpm design:verify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "extends": null,
    "artifactName": "workbench-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../ai-service",
        "to": "app.asar.unpacked/ai-service",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!.env*",
          "!**/.env",
          "!**/.pytest_cache/**",
          "!**/.gitignore",
          "!**/logs/**",
          "!pytest.ini",
          "!README.md",
          "!tests/**",
          "!**/tests/**"
        ]
      }
    ],
    "asarUnpack": [
      "ai-service/**",
      "python-runtime/**"
    ],
    "appId": "io.workbench.v015",
    "productName": "工作台",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "workbench-setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "MultiFlow7",
      "repo": "workbench",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.156",
    "@anthropic-ai/claude-code": "^2.1.156",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "immer": "^11.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^4.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
