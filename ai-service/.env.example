# AI Service 配置模板
# 复制此文件为 .env，填入真实 key 后启动服务

# AI Provider API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# 服务配置
PORT=8000
HOST=0.0.0.0

# Anthropic API 端点（可选，默认官方地址）
# 如需通过自建代理或兼容服务，填入自定义地址
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# 日志目录（默认为服务根目录下 logs/）
# LOG_DIR=/path/to/logs
