# ── 必填 ──────────────────────────────────────────────
# LLM API Key
SUB2API_KEY=your_api_key_here

# LLM 端点（默认直连 Anthropic，也可填 sub2api 或其他兼容代理地址）
SUB2API_URL=https://api.anthropic.com/v1/messages

# ── 路径配置 ───────────────────────────────────────────
# workbench 服务数据目录（数据库、roles 文件等）
DATABASE_URL=/data/workbench/workbench.db
ROLES_DIR=/data/workbench/roles

# file_refs 文件读取的根路径
WORKSPACE_ROOT=/data/workbench

# 用户项目根目录（sandbox 路径白名单前缀）
# 例：PROJECTS_DIR=my-projects → 路径白名单为 my-projects/{project}/产品方向.md
# 本地开发示例：PROJECTS_DIR=/Users/yourname/projects
PROJECTS_DIR=projects

# ── 模型配置 ───────────────────────────────────────────
AGENT_MODEL=claude-opus-4-5

# ── 调度器配置（可选） ──────────────────────────────────
MAX_CONCURRENT_AGENTS=4
DISPATCH_POLL_INTERVAL_SECS=5
AGENT_TIMEOUT_SECS=600
